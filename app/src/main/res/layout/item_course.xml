<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_course_card"
    android:minHeight="72dp">

    <TextView
        android:id="@+id/tv_course_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/btn_add_course"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="AI프로그래밍" />

    <TextView
        android:id="@+id/tv_course_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/font_color2"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/btn_add_course"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_course_name"
        tools:text="반도체 ICT대학 · 컴퓨터정보통신공학부" />

    <ImageView
        android:id="@+id/btn_add_course"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_plus_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 연도 / 학기 / 성적  — 수강이력 모드에서만 노출 -->
    <TextView
        android:id="@+id/tv_year_select"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_field"
        android:gravity="center"
        android:hint="@string/course_year_hint"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#CCCCCC"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_semester_select"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_course_meta"
        app:layout_constraintVertical_bias="0" />

    <TextView
        android:id="@+id/tv_semester_select"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_search_field"
        android:gravity="center"
        android:hint="@string/course_semester_hint"
        android:textColor="@color/text_primary"
        android:textColorHint="#CCCCCC"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_year_select"
        app:layout_constraintEnd_toStartOf="@id/tv_grade_select"
        app:layout_constraintStart_toEndOf="@id/tv_year_select"
        app:layout_constraintTop_toTopOf="@id/tv_year_select" />

    <TextView
        android:id="@+id/tv_grade_select"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_search_field"
        android:gravity="center"
        android:hint="@string/signup_course_grade_hint"
        android:textColor="@color/text_primary"
        android:textColorHint="#CCCCCC"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tv_year_select"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_semester_select"
        app:layout_constraintTop_toTopOf="@id/tv_year_select" />

</androidx.constraintlayout.widget.ConstraintLayout>
